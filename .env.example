# Skopiuj do .env (plik .env nie trafia do repozytorium).
# Dowolny serwer zgodny z OpenAI Chat Completions: API dostawcy w UE albo lokalny vLLM / llama.cpp / Ollama.
# Kolejność dostawców i nazwy zmiennych: config/settings.yaml, llm.providers.

# Dostawca główny
LLM_API_URL=https://api.example.eu/v1
LLM_API_KEY=
LLM_MODEL=

# Dostawca zapasowy — używany, gdy główny nie odpowiada (limit klucza, błąd serwera, sieć). Opcjonalny.
CYFRO_LLM_API_URL=https://llmlab.plgrid.pl/api/v1
CYFRO_LLM_API_KEY=
CYFRO_LLM_MODEL=speakleash/Bielik-11B-v3.1-Instruct
